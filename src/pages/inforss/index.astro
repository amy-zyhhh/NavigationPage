---
import indexRaw from "../../../InfoRSS/index.json?raw";
import settings from "../../data/settings.json";
import { infoRssPostSearchText, infoRssPreviewText, parseInfoRssIndex } from "../../utils/infoRssPosts";

const basePath = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const posts = parseInfoRssIndex(indexRaw);
const categoryFilters = ["全部", ...Array.from(new Set(posts.map((post) => post.category)))];
const dateGroups = Array.from(new Set(posts.map((post) => post.date))).map((date) => ({
	date,
	posts: posts.filter((post) => post.date === date),
}));
---

<html
	lang="zh-CN"
	data-default-theme={settings.theme.default}
	data-theme-storage-key={settings.theme.storageKey}
>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>InfoRSS 通知</title>
	</head>
	<body>
		<main class="shell">
			<nav class="topbar" aria-label="InfoRSS 导航">
				<div class="topbar-main">
					<a href={basePath}>返回</a>
					<form class="notice-search" role="search">
						<label class="sr-only" for="noticeSearchInput">搜索</label>
						<input id="noticeSearchInput" type="search" placeholder="全文搜索通知" autocomplete="off" />
					</form>
					<span>InfoRSS</span>
				</div>

				<div class="category-filter" aria-label="通知分类筛选">
					{categoryFilters.map((category, index) => (
						<button
							type="button"
							class="category-filter-button"
							data-category-filter={category}
							aria-pressed={index === 0 ? "true" : "false"}
						>
							{category}
						</button>
					))}
				</div>
			</nav>

			<section class="notice-list" aria-label="按日期排列的通知">
				{dateGroups.map((group) => (
					<div class="date-group">
						<div class="date-divider">
							<time datetime={group.date}>{group.date}</time>
						</div>
						{group.posts.map((post) => (
							<article class="notice" data-post data-category={post.category} data-search={infoRssPostSearchText(post)}>
								<a class="notice-link" href={`${basePath}inforss/${post.slug}/`}>
									<div class="notice-meta">
										<span>{post.category}</span>
										{post.department && <span>{post.department}</span>}
									</div>
									<h1>{post.title}</h1>
									<p>{infoRssPreviewText(post)}</p>
								</a>
							</article>
						))}
					</div>
				))}
			</section>
			<p class="empty" id="emptyState" hidden>没有找到匹配的通知。</p>
		</main>

		<script>
			const root = document.documentElement;
			const storageKey = root.dataset.themeStorageKey || "navigation-theme";
			const defaultTheme = root.dataset.defaultTheme || "system";
			const searchInput = document.querySelector("#noticeSearchInput");
			const posts = Array.from(document.querySelectorAll("[data-post]"));
			const dateGroups = Array.from(document.querySelectorAll(".date-group"));
			const emptyState = document.querySelector("#emptyState");
			const categoryButtons = Array.from(document.querySelectorAll("[data-category-filter]"));
			let selectedCategory = "全部";

			function systemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function resolveTheme(theme) {
				return theme === "system" ? systemTheme() : theme;
			}

			root.dataset.theme = resolveTheme(localStorage.getItem(storageKey) || defaultTheme);

			function normalizeSearchText(value) {
				return value.trim().toLowerCase();
			}

			function updatePosts() {
				if (!searchInput || !emptyState) return;
				const keywords = normalizeSearchText(searchInput.value).split(/\s+/).filter(Boolean);
				let visibleCount = 0;

				posts.forEach((post) => {
					const searchText = post.dataset.search || "";
					const categoryMatches = selectedCategory === "全部" || post.dataset.category === selectedCategory;
					const searchMatches = keywords.length === 0 || keywords.every((keyword) => searchText.includes(keyword));
					const isVisible = categoryMatches && searchMatches;
					post.hidden = !isVisible;
					if (isVisible) visibleCount += 1;
				});

				dateGroups.forEach((group) => {
					const hasVisiblePost = Array.from(group.querySelectorAll("[data-post]")).some((post) => !post.hidden);
					group.hidden = !hasVisiblePost;
				});

				emptyState.hidden = visibleCount > 0;
			}

			categoryButtons.forEach((button) => {
				button.addEventListener("click", () => {
					selectedCategory = button.dataset.categoryFilter || "全部";
					categoryButtons.forEach((item) => {
						item.setAttribute("aria-pressed", String(item === button));
					});
					updatePosts();
				});
			});

			searchInput?.addEventListener("input", updatePosts);
			updatePosts();
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--bg: #f8f7f3;
		--bg-grid: rgba(43, 54, 52, 0.045);
		--bg-grid-soft: rgba(43, 54, 52, 0.024);
		--panel: #fffdf8;
		--card: #ffffff;
		--text: #1d2928;
		--muted: #64706d;
		--line: #ddd7cc;
		--accent: #267f86;
		--accent-strong: #155e63;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			"Microsoft YaHei", "PingFang SC", sans-serif;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;
		--bg: #171c1d;
		--bg-grid: rgba(236, 242, 238, 0.05);
		--bg-grid-soft: rgba(236, 242, 238, 0.026);
		--panel: #202629;
		--card: #22282b;
		--text: #edf1ef;
		--muted: #a9b3b0;
		--line: #354044;
		--accent: #6db5b8;
		--accent-strong: #9ed5d7;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background:
			linear-gradient(135deg, rgba(38, 127, 134, 0.1) 0%, transparent 34%),
			linear-gradient(315deg, rgba(185, 96, 59, 0.08) 0%, transparent 38%),
			linear-gradient(var(--bg-grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px),
			linear-gradient(var(--bg-grid-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--bg-grid-soft) 1px, transparent 1px),
			var(--bg);
		background-size:
			auto,
			auto,
			32px 32px,
			32px 32px,
			8px 8px,
			8px 8px,
			auto;
		color: var(--text);
	}

	.shell {
		width: min(760px, calc(100% - 32px));
		margin: 0 auto;
		padding: 24px 0 48px;
	}

	.topbar {
		position: sticky;
		top: 0;
		z-index: 2;
		display: grid;
		gap: 10px;
		margin-bottom: 18px;
		padding: 12px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: color-mix(in srgb, var(--panel), transparent 7%);
		backdrop-filter: blur(12px);
	}

	.topbar-main {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 12px;
	}

	.topbar-main a {
		color: var(--accent-strong);
		font-weight: 800;
		text-decoration: none;
	}

	.topbar-main span {
		margin-left: auto;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 800;
	}

	.notice-search {
		width: min(280px, 100%);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	.notice-search input {
		width: 100%;
		height: 34px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		color: var(--text);
		padding: 8px 10px;
		outline: none;
	}

	.notice-search input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 4px rgba(38, 127, 134, 0.14);
	}

	.category-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
	}

	.category-filter-button {
		display: inline-flex;
		align-items: center;
		min-height: 30px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--accent-strong);
		cursor: pointer;
		font: inherit;
		font-size: 0.84rem;
		font-weight: 800;
		padding: 5px 10px;
	}

	.category-filter-button[aria-pressed="true"] {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent), transparent 88%);
	}

	.notice-list,
	.date-group {
		display: grid;
		gap: 12px;
	}

	.notice-list {
		gap: 20px;
	}

	.date-group[hidden],
	.notice[hidden] {
		display: none;
	}

	.date-divider {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0;
	}

	.date-divider::after {
		height: 1px;
		flex: 1;
		background: var(--line);
		content: "";
		opacity: 0.65;
	}

	.notice {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.notice:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.notice-link {
		display: block;
		color: inherit;
		padding: 18px;
		text-decoration: none;
	}

	.notice-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 8px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.notice-meta span {
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 2px 8px;
		color: var(--accent-strong);
	}

	h1 {
		margin: 0;
		font-size: 1.24rem;
		line-height: 1.3;
		letter-spacing: 0;
	}

	p {
		margin: 10px 0 0;
		color: var(--muted);
		line-height: 1.7;
	}

	.empty {
		margin: 36px 0 0;
		color: var(--muted);
		text-align: center;
	}

	@media (max-width: 560px) {
		.topbar-main {
			align-items: flex-start;
			flex-direction: column;
		}

		.topbar-main span {
			margin-left: 0;
		}

		.notice-search {
			width: 100%;
		}
	}

	@media (max-width: 720px) {
		.shell {
			width: min(100% - 24px, 760px);
			padding-top: 12px;
		}

		.notice-link {
			padding: 15px;
		}
	}
</style>

---
import type { BlogPost } from "../utils/blogPosts";
import { blogPostSearchText } from "../utils/searchItems";

interface Props {
	post: BlogPost;
	basePath: string;
}

const { post, basePath } = Astro.props;
const searchText = blogPostSearchText(post);
---

<article class="blog-preview" data-card data-search={searchText}>
	<a class="blog-preview-link" href={`${basePath}blogs/${post.slug}/`}>
		<div class="post-meta">
			<time datetime={post.date}>{post.date}</time>
			<span>{post.category}</span>
		</div>
		<h3>{post.title}</h3>
		{post.summary && <p>{post.summary}</p>}
	</a>
</article>

<style>
	.blog-preview {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--card);
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.blog-preview:hover {
		border-color: var(--accent);
		transform: translateY(-1px);
	}

	.blog-preview[hidden] {
		display: none;
	}

	.blog-preview-link {
		display: block;
		color: inherit;
		padding: 16px;
		text-decoration: none;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 8px;
		color: var(--muted);
		font-size: 0.86rem;
		font-weight: 700;
	}

	.post-meta span {
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 2px 8px;
		color: var(--accent-strong);
	}

	h3 {
		margin: 0;
		font-size: 1.16rem;
		line-height: 1.3;
		letter-spacing: 0;
	}

	p {
		margin: 9px 0 0;
		color: var(--muted);
		line-height: 1.6;
	}

	@media (max-width: 720px) {
		.blog-preview-link {
			padding: 14px;
		}
	}
</style>
